programa
{
    funcao inicio()
    {
        real peso_kg, peso_g

        escreva("Digite o peso em quilos: ")
        leia(peso_kg)

        peso_g = peso_kg * 1000

        escreva("Peso em gramas: ", peso_g, " g\n")
    }
}
